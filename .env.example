# Forbindelse til PostgreSQL
DATABASE_URL=postgres://crm:crm@localhost:5432/crm

# Tillad oprettelse af nye konti via /registrer, selv når der allerede findes brugere.
# Lad den stå på false i drift: første bruger kan altid registrere sig, resten tilføjes af en admin.
ALLOW_REGISTRATION=false

# Appens offentlige adresse (bruges i kode til kontaktformularer og Meta-webhooks)
APP_URL=http://localhost:3000

# Nøgle til kryptering af adgangstokens (32 bytes, base64). Generér med: openssl rand -base64 32
ENCRYPTION_KEY=

# Meta-app (developers.facebook.com). Se docs/meta-opsaetning.md
META_APP_ID=
META_APP_SECRET=
# Selvvalgt hemmelig tekst, som også indtastes i Meta under Webhooks
META_VERIFY_TOKEN=

# Hemmelighed til den daglige synkronisering af annoncedata (Vercel Cron sender den automatisk)
CRON_SECRET=
